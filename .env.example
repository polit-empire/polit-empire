# === База данных MySQL ===
# Данные внешней БД (например с панели хостинга). MYSQL_HOST — это ХОСТ,
# без порта и без "jdbc:mysql://". Порт указывается отдельно в MYSQL_PORT.
# Если в пароле есть спецсимволы (+ ^ = # и т.п.) — заключите значение в
# одинарные кавычки, чтобы Docker не поломал его.
MYSQL_HOST=82.117.87.152
MYSQL_PORT=3306
MYSQL_USER=politempire_db
MYSQL_PASSWORD=strong_password123
MYSQL_DATABASE=politempire_BAZA

# Telegram/Discord бот вынесен в politempire_bots/ — его настройки
# (TG_BOT_TOKEN, DISCORD_TOKEN и др.) задаются в politempire_bots/.env

# === Хранилище файлов (exe лаунчера) ===
# Абсолютный путь на сервере, куда складываются бинарники лаунчера
STORAGE_DIR=/data/politempire

# === Публичный URL приложения ===
APP_URL=https://politempire.example.com

# === Авто-обновление лаунчера ===
# Секретный токен для публикации новых версий лаунчера через
# POST /api/launcher/upload (или node scripts/upload-launcher.mjs).
# Сгенерировать: openssl rand -hex 32
LAUNCHER_UPLOAD_TOKEN=

# === Ссылки на новости в Discord ===
# ID сервера и новостного канала — чтобы клик по новости в лаунчере
# открывал оригинальное сообщение в Discord. Те же значения, что в
# politempire_bots/.env (DISCORD_GUILD_ID, DISCORD_NEWS_CHANNEL_ID).
DISCORD_GUILD_ID=
DISCORD_NEWS_CHANNEL_ID=
# Канал дев-блога: сюда сайт постит анонс новой версии лаунчера (пинг @here)
# и его можно выбрать в рассылке. По умолчанию 1524747101471375430.
DISCORD_DEVBLOG_CHANNEL_ID=

# === GML внутренний адрес API (для проверки accessToken сайтом) ===
# По умолчанию http://gml-web-api:8082; при network_mode: host у app
# укажите http://127.0.0.1:5003 (через gml-web-proxy)
GML_INTERNAL_API_URL=http://127.0.0.1:5003

# === Сервисный аккаунт панели GML (для /api/launcher/optional-mods) ===
# Тот же аккаунт, что использует бот (politempire_bots/.env)
GML_PANEL_LOGIN=
GML_PANEL_PASSWORD=

# === RCON игрового сервера (донат, баны, кик, рассылка) ===
# Хост/порт/пароль RCON Minecraft-сервера. Те же реквизиты, что у бота.
RCON_HOST=127.0.0.1
RCON_PORT=25575
RCON_PASSWORD=

# === Администраторы сайта (админ-панель /admin) ===
# Ники через запятую (без учёта регистра). Дополнительно можно указать
# Telegram ID через ADMIN_TELEGRAM_IDS. Игроки из таблицы bot_admins
# (управляется Telegram-ботом) тоже считаются админами.
ADMIN_NICKS=
ADMIN_TELEGRAM_IDS=

# === Уведомления в Telegram о новых заказах ===
# Тот же токен, что у Python-бота (TG_BOT_TOKEN). Сообщения о заказах уходят
# всем админам из ADMIN_TELEGRAM_IDS и таблицы bot_admins.
TG_BOT_TOKEN=

# === EasyDonate (оплата DC за реальные деньги) ===
# Ключ магазина (секрет). server_id и product_id можно также задать в админке.
# В настройках магазина EasyDonate укажите Callback URL: <SITE_URL>/api/shop/webhook
EASYDONATE_SHOP_KEY=
EASYDONATE_SERVER_ID=138850
EASYDONATE_DC_PRODUCT_ID=1097608
EASYDONATE_EMAIL=shop@politempire.ru

# Публичный адрес сайта (для success_url и ссылок оплаты).
SITE_URL=http://82.117.87.152:7000

# === Порт приложения на хосте ===
# Nginx проксирует на 127.0.0.1:APP_PORT. Если 3000 занят — смените, напр. 3001.
APP_PORT=3000

# === GML — панель управления и бэкенд лаунчер-платформы ===
# Секретный ключ GML (обязательно). Сгенерировать: openssl rand -base64 32
GML_SECURITY_KEY=change-me-random-key
# Имя проекта в GML (без пробелов, используется в путях)
GML_PROJECT_NAME=PolitEmpire
GML_PROJECT_DESCRIPTION='Polit Empire'
GML_PROJECT_POLICYNAME=Policy
# Порт, на котором gml-web-proxy (панель + API GML) доступен на хосте.
# Nginx проксирует поддомен/путь панели на 127.0.0.1:PORT_GML_FRONTEND.
PORT_GML_FRONTEND=5003
# Включить Swagger для Gml.Web.Api (true/false)
GML_SWAGGER_ENABLED=true
# Маркетплейс GML (официальный, менять не нужно)
GML_MARKET_ENDPOINT=https://gml-market.recloud.tech
