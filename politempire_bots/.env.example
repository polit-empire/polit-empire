# Скопируйте в .env и заполните реальными значениями:  cp .env.example .env
# Файл .env в git не попадает (см. .gitignore) — секреты храните только там.

# --- База данных сайта politempire.org (общая с сайтом) ---
# Та же БД, что у сайта: значения MYSQL_* из корневого .env проекта
DB_HOST=82.117.87.152
DB_PORT=3306
DB_NAME=politempire_BAZA
DB_USER=politempire_db
DB_PASSWORD=пароль_от_бд

# --- Telegram ---
TG_BOT_TOKEN=токен_из_BotFather
# Telegram ID администраторов бота через запятую (дополняет таблицу bot_admins)
ADMIN_TELEGRAM_IDS=

# --- Discord ---
DISCORD_TOKEN=токен_из_Discord_Developer_Portal
DISCORD_GUILD_ID=id_вашего_сервера
# Канал, в названии которого показывать онлайн (0 = выключено)
DISCORD_STATUS_CHANNEL_ID=0
ONLINE_UPDATE_INTERVAL=30
CHANNEL_RENAME_INTERVAL=300
# Канал новостей: посты сохраняются в БД и показываются в лаунчере (0 = выключено).
# Боту нужен Message Content Intent (Developer Portal -> Bot -> включить).
DISCORD_NEWS_CHANNEL_ID=1516464340889501756
NEWS_BACKFILL_LIMIT=20
# Канал для логов античита (нарушения из лаунчера). 0 = выключено.
DISCORD_ANTICHEAT_CHANNEL_ID=1516453506188316903
# Как часто проверять новые события античита в БД (секунды)
ANTICHEAT_POLL_INTERVAL=15

# --- Minecraft ---
MC_HOST=адрес_сервера
MC_PORT=25565
RCON_HOST=адрес_сервера
RCON_PORT=25575
RCON_PASSWORD=пароль_rcon

# --- HTTP API для плагина ---
API_HOST=0.0.0.0
API_PORT=8180
# Секрет для плагина (заголовок X-Api-Secret). Сгенерируйте: openssl rand -hex 32
API_SECRET=случайная_строка_hex

# --- GML (панель управления) ---
# Адрес gml-web-proxy на этом же сервере (бот в network_mode: host)
GML_API_URL=http://127.0.0.1:5003
# Сервисный аккаунт панели: создайте в панели отдельного пользователя для бота.
# Нужен, чтобы статус аккаунта в боте показывал баны, выданные в панели GML.
GML_PANEL_LOGIN=
GML_PANEL_PASSWORD=

# --- Логика ---
REFERRAL_PLAYTIME_SECONDS=600
TWOFA_CODE_TTL=300
