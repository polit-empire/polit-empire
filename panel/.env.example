# URL бэкенда Gml.Web.Api (обязательно)
# Панель ходит в API через gml-web-proxy (/api -> gml-web-api).
# На VDS с nginx (поддомен): https://gml.politempire.org/api/v1
# Локально через docker-compose: http://localhost:5003/api/v1
NEXT_PUBLIC_BACKEND_URL=https://gml.politempire.org/api/v1

# Маркетплейс GML (необязательно, официальный)
NEXT_PUBLIC_MARKETPLACE_URL=https://gml-market.recloud.tech
